# StandUp Companion — Phase 2 Backend Config
# Copy this file to .env and fill in your values when ready to connect

# ─── Database (Phase 2: Supabase PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/standup_companion

# ─── Supabase Auth (Phase 2) ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Features (Phase 2: Premise Expander + Laugh Analyzer) ─────────────────
OPENAI_API_KEY=sk-...

# ─── Session Secret ───────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
