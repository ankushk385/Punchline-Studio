{
  "expo": {
    "name": "Punchline Studio",
    "slug": "punchline-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "punchlinestudio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.punchlinestudio.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Punchline Studio uses your microphone for voice notes, recordings, and on-device sound-paced teleprompter control.",
        "NSPhotoLibraryUsageDescription": "Punchline Studio needs access to your photo library to save recordings."
      }
    },
    "android": {
      "package": "com.punchlinestudio.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFDF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Punchline Studio uses your calendar to add and update your gigs.",
          "remindersPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Punchline Studio uses your microphone for voice notes, recordings, and on-device sound-paced teleprompter control.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "bbc056fa-46b1-448a-a0de-4bd2ba528e40"
      }
    }
  }
}
